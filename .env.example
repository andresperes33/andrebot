# .env.example — copie este arquivo para .env e preencha suas credenciais
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_GROUP_ID=seu_group_id_aqui
SOURCE_CHANNEL_USERNAME=Iskandar Souza - Promoções
# Canais extras monitorados ao mesmo tempo (JSON ou nomes separados por vírgula):
EXTRA_SOURCE_CHANNELS_JSON=[{"nome": "Promoções Gamer"}, {"nome": "TECNAN OFERTAS"}]
# Também funciona: EXTRA_SOURCE_CHANNELS_JSON=Promoções Gamer
# Canal TECNAN OFERTAS (links camuflados eioferta.com.br). Vem ativado por
# padrão; deixe vazio para desativar: TECNAN_SOURCE_CHANNEL=
# Canal PEPERAIO HARDWARE OFERTAS. Vem ativado por padrão; deixe vazio para
# desativar: PEPERAIO_SOURCE_CHANNEL=
SITE_URL=https://promos.andreindicatech.com.br
SHOPEE_APP_ID=seu_app_id_aqui
SHOPEE_SECRET=seu_secret_aqui
WAHA_URL=https://sua-waha.exemplo.com
WAHA_API_KEY=sua_api_key_aqui
WAHA_SESSION=default
WHATSAPP_GROUP_JID=seu_jid_do_grupo_aqui@g.us
